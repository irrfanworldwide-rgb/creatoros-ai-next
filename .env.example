# ===== Supabase (public — safe in client bundle, matches original app) =====
# These are your project's public URL and publishable/anon key — safe to
# ship in this file since they're already embedded in the original
# client-side index.html bundle today.
NEXT_PUBLIC_SUPABASE_URL=https://kpmmuvjvtexncrsslgli.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gxvjHJTCVFx5egq8-w4cXQ_vs9fy5SM

# Used for SEO metadata, sitemap.xml, and Open Graph URLs. Set to your
# production domain when deploying — see DEPLOYMENT_CHECKLIST.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Server-only secrets (used by Next.js API routes) =====
# Never prefix these with NEXT_PUBLIC_ — that would expose them to the
# browser bundle. Fill in your real values; see SETUP.md.

# AI generation — powers every tool (scripts, hooks, captions, hashtags,
# CTAs, etc.) and AI Chat. Choose ONE provider below, then set only that
# provider's key.
#
# AI_PROVIDER selects which one app/api/generate/route.ts calls.
# Options: "groq" (default — matches the live app), "openai", "anthropic"
AI_PROVIDER=groq

# --- Groq (used when AI_PROVIDER=groq) ---
# Get a key at https://console.groq.com/keys
# Groq exposes an OpenAI-compatible endpoint, so any Groq-hosted model
# name works here (Llama, Mixtral, Gemma, etc.)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (used when AI_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used when AI_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ===== Razorpay (Phase 5 — Pro plan upgrade) =====
# Get both from your Razorpay Dashboard → Settings → API Keys.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is not secret — Razorpay's key_id is safe to
# ship to the browser (it's how checkout.js identifies your account) and
# is also read server-side for order creation, so only one variable is
# needed instead of two holding the same value.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET is secret — never prefix with NEXT_PUBLIC_, never
# expose to the browser. Used only in app/api/payments/* server routes.
RAZORPAY_KEY_SECRET=

# Use Razorpay TEST mode keys (rzp_test_...) while developing — see
# SETUP.md for test card numbers and how to switch to live keys.

# ===== Razorpay Subscriptions (Phase 9 — recurring auto-renewing Pro) =====
# The Plan ID from the ₹299/month Plan you created in Razorpay Dashboard →
# Subscriptions → Plans (looks like "plan_XXXXXXXXXXXXXX").
RAZORPAY_PLAN_ID=
# From Razorpay Dashboard → Settings → Webhooks, after registering
# <your-domain>/api/payments/webhook there. This is a DIFFERENT secret
# from RAZORPAY_KEY_SECRET — see SETUP.md §2c for full webhook setup.
RAZORPAY_WEBHOOK_SECRET=

# ===== Supabase service-role key (Phase 9 webhook, Phase 10 Admin Panel) =====
# From Supabase Dashboard → Settings → API → service_role (secret) key.
# Used by app/api/payments/webhook/route.ts AND every app/api/admin/*
# route, since both have no regular user session to scope a normal
# request to. Never exposed to the browser, never used outside server
# routes. Treat this as highly sensitive — it bypasses Row Level
# Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Admin Panel (Phase 10) =====
# Signs admin session cookies (separate from Supabase/Razorpay secrets).
# Generate a long random string, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# There is no admin signup UI (by design). Create your first admin with:
#   node scripts/create-admin.mjs <username> <password> [admin|superadmin]
# See SETUP.md §2d.
